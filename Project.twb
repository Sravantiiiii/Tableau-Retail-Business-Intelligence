              <calculation class='tableau' formula='0.5' />
              <range granularity='0.05' max='0.5' min='-0.5' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1ywqxet04nilb612i1bpu0rgb9a5'>
